---
import Notebook from "../layouts/Notebook.astro";
import WeekRow from "../components/WeekRow.astro";
import { CLUB, FIRST_MEETING } from "../data/people";
import { CARD } from "../data/card";
import {
  MEETING,
  PLACE,
  TERMS,
  UPDATED,
  WEEKS,
  kalamazooISO,
  properCase,
  sentenceCase,
  shortDate,
} from "../data/schedule";

// The whole year on one sheet. Every meeting is the same night, time and room,
// so that's said once up top and each line only carries what changes: the
// date and what's on. Past weeks get crossed off and the next one circled by
// the inline script in Notebook.astro.

const feed = new URL("/qbronco.ics", Astro.site ?? "https://qbronco.com");
const webcal = `webcal://${feed.host}${feed.pathname}`;
const google = `https://calendar.google.com/calendar/render?cid=${webcal}`;

const checkpoints = WEEKS.filter((w) => w.about);

// every meeting as a schema.org Event, so search engines and AI assistants can
// read the schedule without parsing the page
const site = Astro.site ?? new URL("https://qbronco.com");
const events = {
  "@context": "https://schema.org",
  "@graph": WEEKS.filter((w) => w.kind !== "off").map((w) => ({
    "@type": "Event",
    "@id": new URL(`/schedule#${w.date}`, site),
    name: `QBronco: ${sentenceCase(w.title)}${w.proposed ? " (proposed)" : ""}`,
    startDate: kalamazooISO(w.start),
    endDate: kalamazooISO(w.end),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    isAccessibleForFree: true,
    description: [
      w.about && properCase(w.about),
      w.proposed && "Proposed date; it can still move.",
      !w.proposed && w.tentative && "Spring dates can still move.",
      "No experience needed; just show up.",
    ]
      .filter(Boolean)
      .join(" "),
    location: {
      "@type": "Place",
      name: `${PLACE.building} ${w.room ?? MEETING.room}, ${PLACE.university} ${PLACE.campus}`,
      address: {
        "@type": "PostalAddress",
        streetAddress: PLACE.street,
        addressLocality: PLACE.city,
        addressRegion: PLACE.region,
        postalCode: PLACE.postalCode,
        addressCountry: PLACE.country,
      },
      geo: { "@type": "GeoCoordinates", ...PLACE.geo },
    },
    organizer: { "@type": "Organization", "@id": new URL("/#club", site), name: CLUB.name, url: new URL("/", site) },
    image: [new URL("/reel/bell-lab-room-640.webp", site), new URL(CARD, site)],
    url: new URL("/schedule", site),
  })),
};
---

<Notebook
  page="schedule"
  title="Schedule · QBronco (Quantum Broncos)"
  description={`Every QBronco (Quantum Broncos) meeting for 2026–27: Wednesdays ${MEETING.time} in ${PLACE.building} ${MEETING.room} at WMU. Subscribe and date changes show up on their own.`}
  scrawl={`~ updated ${shortDate(UPDATED)}`}
  turn={{ label: "the project", href: "/project" }}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(events).replace(/</g, "\\u003c")} />

  <header class="page-head">
    <div class="title-head">
      <h1 class="page-title">the schedule</h1>
      <svg class="title-underline" viewBox="0 0 320 26" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="#c2362f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path vector-effect="non-scaling-stroke" d="M6 9 Q80 3 160 7 Q240 11 314 5"/><path vector-effect="non-scaling-stroke" d="M10 18 Q84 13 158 16 Q236 19 308 14"/></svg>
    </div>
  </header>

  <section>
    <p>
      every wednesday, {MEETING.time}, {MEETING.building} <span class="nobreak">{MEETING.room}</span> on {MEETING.campus} campus
      (<a class="pen-blue" href={MEETING.map} target="_blank" rel="noopener noreferrer">map</a>).
      labs are project nights, study sessions are for learning the basics, and
      you're welcome at both. no meetings over breaks or finals.
    </p>
    <p>
      <strong>first time?</strong> bring {FIRST_MEETING.bring}. starting partway
      through the semester? {FIRST_MEETING.catchUp}.
    </p>

    <div class="terms">
      {
        TERMS.map((term) => (
          <div class="term">
            <h2 class="term-label">
              {term.label}
              {term.note && <span class="term-note">({term.note})</span>}
            </h2>
            <ul class="weeks">
              {WEEKS.filter((w) => w.term === term.id).map((week) => (
                <WeekRow week={week} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <ul class="notes">
      {
        checkpoints.map((week) => (
          <li>
            <span class="wk-star" aria-hidden="true">*</span>
            <strong>
              {week.title}, {week.label}.
            </strong>{" "}
            {week.about}
          </li>
        ))
      }
      <li class="soft">spring dates and both Qubi workshops can still move.</li>
    </ul>
  </section>

  <section id="calendar">
    <h2 class="tilt-b">put it in your calendar</h2>
    <p>
      subscribe once and every meeting shows up in your calendar. if a date
      moves, your calendar moves with it.
    </p>
    <ul class="contacts">
      <li><a class="pen-blue" href={google} target="_blank" rel="noopener noreferrer">subscribe in google calendar</a></li>
      <li><a class="pen-blue" href={webcal}>subscribe in apple or outlook calendar</a></li>
      <li>anything else: <a class="pen-blue" href="/qbronco.ics" download>download the .ics file</a></li>
    </ul>
  </section>
</Notebook>
