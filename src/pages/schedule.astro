---
import Notebook from "../layouts/Notebook.astro";
import WeekRow from "../components/WeekRow.astro";
import { MEETING, TERMS, UPDATED, WEEKS, shortDate } from "../data/schedule";

// The whole year on one sheet. Every meeting is the same night, time and room,
// so that's said once up top and each line only carries what changes: the
// date and what's on. Past weeks get crossed off and the next one circled by
// the inline script in Notebook.astro.

const feed = new URL("/qbronco.ics", Astro.site ?? "https://qbronco.com");
const webcal = `webcal://${feed.host}${feed.pathname}`;
const google = `https://calendar.google.com/calendar/render?cid=${webcal}`;

const checkpoints = WEEKS.filter((w) => w.about);
---

<Notebook
  page="schedule"
  title="schedule · QBronco"
  description="Every QBronco meeting for 2026–27: Wednesdays 6:30–8:30 pm in room D-212 on WMU's Parkview campus. Subscribe to the calendar and changes show up on their own."
  scrawl={`~ updated ${shortDate(UPDATED)}`}
  turn={{ label: "the project", href: "/project" }}
>
  <header class="page-head">
    <div class="title-head">
      <h1 class="page-title">the schedule</h1>
      <svg class="title-underline" viewBox="0 0 320 26" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="#c2362f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path vector-effect="non-scaling-stroke" d="M6 9 Q80 3 160 7 Q240 11 314 5"/><path vector-effect="non-scaling-stroke" d="M10 18 Q84 13 158 16 Q236 19 308 14"/></svg>
    </div>
  </header>

  <section>
    <p>
      every wednesday, {MEETING.time}, room {MEETING.room} on {MEETING.campus} campus
      (<a class="pen-blue" href={MEETING.map} target="_blank" rel="noopener noreferrer">map</a>).
      labs are project nights, study sessions are for learning the basics, and
      you're welcome at both. no meetings over breaks or finals.
    </p>

    <div class="terms">
      {
        TERMS.map((term) => (
          <div class="term">
            <h2 class="term-label">
              {term.label}
              {term.note && <span class="term-note">({term.note})</span>}
            </h2>
            <ul class="weeks">
              {WEEKS.filter((w) => w.term === term.id).map((week) => (
                <WeekRow week={week} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <ul class="notes">
      {
        checkpoints.map((week) => (
          <li>
            <span class="wk-star" aria-hidden="true">*</span>
            <strong>
              {week.title}, {week.label}.
            </strong>{" "}
            {week.about}
          </li>
        ))
      }
      <li class="soft">spring dates and both Qubi workshops can still move.</li>
    </ul>
  </section>

  <section id="calendar">
    <h2 class="tilt-b">put it in your calendar</h2>
    <p>
      subscribe once and every meeting shows up in your calendar. if a date
      moves, your calendar moves with it.
    </p>
    <ul class="contacts">
      <li>google calendar: <a class="pen-blue" href={google} target="_blank" rel="noopener noreferrer">subscribe</a></li>
      <li>apple, outlook: <a class="pen-blue" href={webcal}>subscribe</a></li>
      <li>anything else: <a class="pen-blue" href="/qbronco.ics" download>download the .ics file</a></li>
    </ul>
  </section>
</Notebook>
