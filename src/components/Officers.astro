---
import { OFFICERS } from "../data/people";

// Cut-out headshots, each circled once in pencil. Photo + name are one link
// (LinkedIn, or the WMU directory for the advisor), so the tap target is big.
---

<ul class="officers">
  {
    OFFICERS.map((officer) => (
      <li class="officer" style={`--tilt: ${officer.tilt}deg`}>
        <a class="officer-link" href={officer.href} target="_blank" rel="noopener noreferrer">
          <span class="officer-photo">
            <img src={officer.photo} alt="" width="320" height="320" loading="lazy" decoding="async" />
          </span>
          <span class="officer-name">{officer.name}</span>
          <span class="sr-only">
            {officer.href.includes("linkedin.com") ? "on LinkedIn" : "on the WMU directory"}
          </span>
        </a>
        <span class="officer-role">{officer.role}</span>
      </li>
    ))
  }
</ul>
