---
// Decorative quantum circuit pattern that drifts horizontally behind the
// Events section. Very low opacity — pure visual texture.
---

<div
  class="circuit-bg pointer-events-none absolute inset-0 z-0 overflow-hidden"
  aria-hidden="true"
>
  <svg
    class="circuit-bg__track"
    height="240"
    viewBox="0 0 1200 240"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    <!-- two copies of the pattern side-by-side for seamless loop -->
    <g class="circuit-bg__pattern">
      <!-- wires -->
      <line x1="0" y1="60" x2="600" y2="60" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />
      <line x1="0" y1="120" x2="600" y2="120" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />
      <line x1="0" y1="180" x2="600" y2="180" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />

      <!-- Hadamard gate on wire 1 -->
      <rect x="60" y="40" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="80" y="66" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="16" fill="var(--accent)" fill-opacity="0.9">H</text>

      <!-- CNOT: control on wire 1, target on wire 2 -->
      <line x1="160" y1="60" x2="160" y2="120" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.7" />
      <circle cx="160" cy="60" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="160" cy="120" r="10" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <line x1="160" y1="110" x2="160" y2="130" stroke="var(--accent)" stroke-opacity="0.7" />
      <line x1="150" y1="120" x2="170" y2="120" stroke="var(--accent)" stroke-opacity="0.7" />

      <!-- Pauli-X gate on wire 3 -->
      <rect x="220" y="160" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="240" y="186" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="16" fill="var(--accent)" fill-opacity="0.9">X</text>

      <!-- Rotation gate Rz on wire 2 -->
      <rect x="300" y="100" width="56" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="328" y="126" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="14" fill="var(--accent)" fill-opacity="0.9">Rz</text>

      <!-- Measurement on wire 1 -->
      <rect x="400" y="40" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <path d="M 408 70 A 12 12 0 0 1 432 70" stroke="var(--accent)" stroke-opacity="0.9" stroke-width="1" fill="none" />
      <line x1="420" y1="70" x2="432" y2="50" stroke="var(--accent)" stroke-opacity="0.9" stroke-width="1" />

      <!-- Toffoli-style multi-controlled gate -->
      <line x1="500" y1="60" x2="500" y2="180" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.7" />
      <circle cx="500" cy="60" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="500" cy="120" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="500" cy="180" r="10" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <line x1="500" y1="170" x2="500" y2="190" stroke="var(--accent)" stroke-opacity="0.7" />
      <line x1="490" y1="180" x2="510" y2="180" stroke="var(--accent)" stroke-opacity="0.7" />
    </g>
    <!-- duplicate copy for seamless horizontal loop -->
    <g transform="translate(600, 0)">
      <line x1="0" y1="60" x2="600" y2="60" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />
      <line x1="0" y1="120" x2="600" y2="120" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />
      <line x1="0" y1="180" x2="600" y2="180" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.5" />

      <rect x="60" y="40" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="80" y="66" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="16" fill="var(--accent)" fill-opacity="0.9">H</text>

      <line x1="160" y1="60" x2="160" y2="120" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.7" />
      <circle cx="160" cy="60" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="160" cy="120" r="10" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <line x1="160" y1="110" x2="160" y2="130" stroke="var(--accent)" stroke-opacity="0.7" />
      <line x1="150" y1="120" x2="170" y2="120" stroke="var(--accent)" stroke-opacity="0.7" />

      <rect x="220" y="160" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="240" y="186" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="16" fill="var(--accent)" fill-opacity="0.9">X</text>

      <rect x="300" y="100" width="56" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <text x="328" y="126" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="14" fill="var(--accent)" fill-opacity="0.9">Rz</text>

      <rect x="400" y="40" width="40" height="40" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <path d="M 408 70 A 12 12 0 0 1 432 70" stroke="var(--accent)" stroke-opacity="0.9" stroke-width="1" fill="none" />
      <line x1="420" y1="70" x2="432" y2="50" stroke="var(--accent)" stroke-opacity="0.9" stroke-width="1" />

      <line x1="500" y1="60" x2="500" y2="180" stroke="var(--accent)" stroke-width="1" stroke-opacity="0.7" />
      <circle cx="500" cy="60" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="500" cy="120" r="4" fill="var(--accent)" fill-opacity="0.85" />
      <circle cx="500" cy="180" r="10" stroke="var(--accent)" stroke-opacity="0.7" fill="var(--bg)" />
      <line x1="500" y1="170" x2="500" y2="190" stroke="var(--accent)" stroke-opacity="0.7" />
      <line x1="490" y1="180" x2="510" y2="180" stroke="var(--accent)" stroke-opacity="0.7" />
    </g>
  </svg>
</div>
