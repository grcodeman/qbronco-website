---
import { REEL, REEL_WIDTHS, reelSrcset } from "../data/people";

// A strip of instant photos taped across the sheet. It scrolls sideways on its
// own (swipe, trackpad, arrow keys once focused, or the pencil arrows) and
// bleeds off the right edge of the paper so it's obvious there's more. Every
// print is the same 4:3 size: 7 rules tall, 4/3 of that wide.
const largest = REEL_WIDTHS[REEL_WIDTHS.length - 1];
---

<div class="reel-head">
  <h2 class="tilt-b">what wednesdays look like</h2>
  <div class="reel-nav" data-reel-nav="reel" hidden>
    <button type="button" data-dir="-1" aria-label="Previous photos">&larr;</button>
    <button type="button" data-dir="1" aria-label="More photos">&rarr;</button>
  </div>
</div>

<div class="reel" id="reel" data-reel tabindex="0" role="region" aria-label="Photos from our meetings">
  <ul class="reel-track">
    {
      REEL.map((photo, i) => (
        <li class="polaroid" style={`--tilt: ${photo.tilt}deg`}>
          <img
            src={`/reel/${photo.photo}-${largest}.webp`}
            srcset={reelSrcset(photo.photo)}
            sizes="(max-width: 640px) 243px, 262px"
            alt={photo.alt}
            width={largest}
            height={(largest * 3) / 4}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="polaroid-caption">{photo.caption}</span>
        </li>
      ))
    }
  </ul>
</div>
