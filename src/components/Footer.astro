---
import { site } from "../content/site";
const { footer } = site;
---

<footer class="relative border-t border-[var(--line)] mt-12">
  <div class="container grid grid-cols-1 gap-12 py-16 md:grid-cols-3 md:py-24">
    <div class="flex flex-col gap-3">
      <span class="font-display text-2xl font-medium lowercase tracking-[-0.02em] text-text">
        {footer.wordmark}
      </span>
      <p class="mono text-2xs text-text-dim">{footer.tagline}</p>
    </div>

    <div class="flex flex-col gap-3">
      <p class="mono text-2xs uppercase tracking-[0.18em] text-text-dim">
        quick links
      </p>
      <ul class="flex flex-col gap-2">
        {
          footer.quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="mono text-2xs text-text-muted transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex flex-col gap-3">
      <p class="mono text-2xs uppercase tracking-[0.18em] text-text-dim">
        elsewhere
      </p>
      <ul class="flex flex-col gap-2">
        {
          footer.socials.map((social) => (
            <li>
              <a
                href={social.href}
                class="mono text-2xs text-text-muted transition-colors hover:text-accent"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-[var(--line)]">
    <div class="container py-6">
      <p class="mono text-2xs text-text-dim">{footer.legal}</p>
    </div>
  </div>
</footer>
