---
import { site } from "../content/site";
---

<section id="superposition" class="section relative">
  <div class="container flex flex-col items-center text-center">
    <p class="kicker mb-12 md:mb-20">{site.superposition.kicker}</p>

    <div class="flex flex-col gap-4 md:gap-6">
      {
        site.superposition.lines.map((line) => (
          <p class="font-display text-[clamp(2rem,6vw,4.5rem)] font-medium leading-[1.05] tracking-[-0.02em] text-text">
            {line}
          </p>
        ))
      }
    </div>

    <div
      class="mt-16 h-px w-full max-w-[800px] bg-[var(--accent)] opacity-30 md:mt-24"
      aria-hidden="true"
    >
    </div>
  </div>
</section>
