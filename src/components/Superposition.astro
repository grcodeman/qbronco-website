---
import { site } from "../content/site";
---

<section
  id="superposition"
  class="section relative"
  data-superposition
>
  <div class="container flex flex-col items-center text-center">
    <p class="kicker mb-12 md:mb-20" data-reveal>{site.superposition.kicker}</p>

    <div class="superposition__lines flex flex-col gap-6 md:gap-10">
      {
        site.superposition.lines.map((line) => (
          <p
            class="superposition__line font-display text-[clamp(2rem,6vw,4.5rem)] font-medium leading-[1.05] tracking-[-0.02em] text-text"
            data-line
            data-text={line}
          >
            {line}
          </p>
        ))
      }
    </div>

    <svg
      class="mt-16 w-full max-w-[800px] md:mt-24"
      height="2"
      viewBox="0 0 800 2"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M 0 1 L 800 1"
        stroke="var(--accent)"
        stroke-width="1"
        stroke-opacity="0.4"
        stroke-dasharray="800"
        stroke-dashoffset="800"
        fill="none"
        data-divider-path
      ></path>
    </svg>
  </div>
</section>
