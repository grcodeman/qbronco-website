---
import { site } from "../content/site";
---

<section
  id="hero"
  class="relative flex min-h-screen w-full items-end overflow-hidden"
>
  <div class="container-wide relative z-10 grid w-full grid-cols-1 gap-12 pb-12 pt-32 md:grid-cols-12 md:pb-20 md:pt-40">
    <!-- Text column -->
    <div class="md:col-span-7 lg:col-span-6 flex flex-col gap-6">
      <p class="kicker">{site.hero.kicker}</p>

      <h1
        class="font-display font-medium text-text glow-text text-[clamp(3.5rem,12vw,8rem)] leading-[0.95] tracking-[-0.04em]"
      >
        Quantum<br />Broncos
      </h1>

      <p class="max-w-[40ch] text-lg md:text-xl text-text-muted leading-[1.5]">
        {site.hero.subhead}
      </p>
    </div>

    <!-- Qubit column placeholder; replaced with R3F Canvas in Phase 3 -->
    <div
      class="md:col-span-5 lg:col-span-6 relative flex aspect-square w-full items-center justify-center"
      aria-hidden="true"
    >
      <div id="qubit-mount" class="relative h-full w-full">
        <!-- Static fallback / scaffold while qubit Canvas is not yet mounted -->
        <div
          class="absolute inset-1/2 -translate-x-1/2 -translate-y-1/2 aspect-square w-[min(80%,520px)] rounded-full border border-[var(--line)]"
        >
        </div>
        <div
          class="absolute inset-1/2 -translate-x-1/2 -translate-y-1/2 aspect-square w-[min(60%,400px)] rotate-[-18deg] rounded-full border border-[var(--line)]"
        >
        </div>
        <div
          class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent"
          style="box-shadow: 0 0 24px var(--accent-glow), 0 0 48px var(--accent-glow);"
        >
        </div>
        <span
          class="mono absolute left-1/2 top-[8%] -translate-x-1/2 text-xs text-text-muted"
          >|0⟩</span
        >
        <span
          class="mono absolute left-1/2 bottom-[8%] -translate-x-1/2 text-xs text-text-muted"
          >|1⟩</span
        >
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="pointer-events-none absolute bottom-8 right-6 z-10 flex flex-col items-center gap-3 md:right-12 md:bottom-12"
  >
    <span class="mono text-[0.6875rem] uppercase tracking-[0.2em] text-text-dim"
      >scroll</span
    >
    <span
      class="block h-12 w-px bg-text-dim"
      aria-hidden="true"
    ></span>
  </div>
</section>
