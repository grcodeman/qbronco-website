---
import { site } from "../content/site";
import Qubit from "./qubit/Qubit";
---

<section
  id="hero"
  class="relative flex min-h-screen w-full items-center overflow-hidden"
>
  <div
    class="container-wide relative z-10 grid w-full grid-cols-1 items-center gap-8 pb-16 pt-28 md:grid-cols-12 md:gap-12 md:pb-20 md:pt-32"
  >
    <!-- Text column -->
    <div
      class="md:col-span-7 lg:col-span-6 flex flex-col gap-6 md:gap-8"
    >
      <p class="kicker">{site.hero.kicker}</p>

      <h1
        class="font-display font-medium text-text glow-text text-[clamp(3.25rem,10vw,7.5rem)] leading-[0.92] tracking-[-0.04em]"
      >
        Quantum<br />Broncos
      </h1>

      <p
        class="max-w-[36ch] text-base md:text-lg text-text-muted leading-[1.55]"
      >
        {site.hero.subhead}
      </p>
    </div>

    <!-- Qubit island: vertically centered, size capped so it partners with
         the heading instead of dominating it. -->
    <div
      class="md:col-span-5 lg:col-span-6 relative flex w-full items-center justify-center md:justify-end"
    >
      <div class="w-full max-w-[420px] md:max-w-[460px] lg:max-w-[520px]">
        <Qubit client:load />
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div
    class="pointer-events-none absolute bottom-6 right-6 z-10 flex flex-col items-center gap-3 md:right-12 md:bottom-10"
  >
    <span
      class="mono text-[0.6875rem] uppercase tracking-[0.2em] text-text-dim"
      >scroll</span
    >
    <span class="block h-12 w-px bg-text-dim" aria-hidden="true"></span>
  </div>
</section>
